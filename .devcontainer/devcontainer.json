{
  "name": "Piano Lo-Key",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "postAttachCommand": { "app": "bash scripts/start.sh" },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Piano Lo-Key", "onAutoForward": "openBrowser" },
    "8000": { "label": "Song analyzer API", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
